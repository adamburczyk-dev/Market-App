# ============================================================
# .env.example — skopiuj do .env i uzupełnij wartości
# docker compose NIE wystartuje bez DB_PASSWORD i REDIS_PASSWORD
#
# Każda zmienna poniżej jest FAKTYCZNIE czytana przez
# infrastructure/docker-compose.yml, a wartość po "=" to domyślna z compose.
# Pusta wartość znaczy więc "domyślnie wyłączone", nie "do uzupełnienia
# kiedyś". W drugą stronę: zmienna, której compose nie przekazuje, nie
# istnieje dla kontenerów — nawet jeśli serwis deklaruje ją w config.py.
# ============================================================

# --- WYMAGANE (compose odmówi startu) ---
DB_PASSWORD=change_me_in_production_123!
REDIS_PASSWORD=change_me_redis_456!

# --- Podstawy ---
DB_NAME=trading_db
DB_USER=trader
LOG_LEVEL=DEBUG
GRAFANA_PASSWORD=admin

# ============================================================
# CZY SYSTEM PRACUJE SAM
#
# To jest sekcja, bez której stack wstaje "zdrowy" i nie robi NIC. Oba
# harmonogramy są domyślnie włączone, ale ich listy symboli są puste, więc
# zadanie cykliczne startuje i nie ma czego pobrać. Serwisy mówią to wprost
# w logu przy starcie ("Scheduled pull idle — set FETCH_SYMBOLS to enable
# it"), ale jedna linia INFO to całe ostrzeżenie, jakie dostaniesz.
#
# Cały łańcuch zdarzeń jest zakotwiczony w `market_data.updated`, więc bez
# FETCH_SYMBOLS system nie przepracuje samodzielnie ani jednego dnia — a
# reguła "30 dni papieru z dodatnim Sharpe'em przed realnym kapitałem" nie
# ma jak zacząć się naliczać.
# ============================================================

# market-data: dzienne pobranie przyrostowe (wznawia od ostatniej świecy)
SCHEDULE_FETCH_ENABLED=true
FETCH_SYMBOLS=
FETCH_AT_HOUR_UTC=23              # po zamknięciu sesji US, nie 24h od startu kontenera
FETCH_INITIAL_HISTORY_DAYS=2190   # ~6 lat przy pierwszym pobraniu symbolu
FETCH_OVERLAP_DAYS=5              # zakładka wykrywająca restatement (split -> adj_close)
FETCH_SYMBOL_PAUSE_S=1.0

# fundamental-data: tygodniowe odświeżenie panelu z SEC EDGAR
SCHEDULE_REFRESH_ENABLED=true
REFRESH_SYMBOLS=
REFRESH_SYMBOL_PAUSE_S=1.0

# ============================================================
# DOSTĘP DO DANYCH
# ============================================================

# SEC EDGAR nie wymaga klucza, ale WYMAGA kontaktu w User-Agent i odrzuca
# ruch bez niego. Format: "Nazwa/1.0 adres@email".
SEC_USER_AGENT=

# FRED / ALFRED (macro-data). Bez klucza serwis przechodzi w tryb "polegam
# na ręcznie wysłanych wskaźnikach", panel vintage zostaje pusty, a pięć
# kolumn macro_* wypada w treningu jako stałe. Klucz jest darmowy:
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Alternatywne źródło OHLCV dla market-daty (Yahoo jest domyślne).
ALPHA_VANTAGE_API_KEY=

# ============================================================
# POWIADOMIENIA (notification) — wszystkie opcjonalne.
# Bez żadnego z nich alerty lądują wyłącznie w logu.
# ============================================================
MIN_SEVERITY=info
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ============================================================
# PRODUKCJA (czytane tylko przez docker-compose.prod.yml)
# ============================================================
ACME_EMAIL=                       # Let's Encrypt dla Traefika

# ============================================================
# USUNIĘTE 2026-08-04, bo NIC ich nie czytało:
#   ANTHROPIC_API_KEY  — pod `llm-svc`, decyzja D6 odłożona
#   INITIAL_CAPITAL    — kapitał startowy jest w config.py execution
#   PAPER_TRADING      — cała ścieżka egzekucji jest papierowa z założenia
# Zmienna w .env.example, której nikt nie czyta, to obietnica konfiguracji,
# której ustawienie nie ma żadnego skutku.
# ============================================================
